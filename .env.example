# Firebase App Check용 reCAPTCHA Enterprise 사이트 키입니다.
# Firebase Console에서 웹 앱을 App Check에 등록한 뒤 설정하세요.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Google Play 출시 후 웹의 랭킹 도전 버튼이 이동할 스토어 URL입니다.
VITE_ANDROID_STORE_URL=

# App Store 출시 전에는 공식 웹 주소로 대체됩니다.
VITE_IOS_STORE_URL=

# Sentry 프로젝트 Settings > Client Keys (DSN)의 전체 DSN입니다.
VITE_SENTRY_DSN=

# Android 보상형 광고 단위 ID입니다. 예: ca-app-pub-.../...
VITE_ADMOB_REWARDED_AD_UNIT_ID=

# Functions 로컬 실행용 값입니다. 배포 환경에는 같은 이름으로 별도 설정하세요.
ADMOB_REWARDED_AD_UNIT_ID=
