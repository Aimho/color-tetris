{
  "name": "color-bomb",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-capacitor-admob.mjs",
    "dev": "vite --host 0.0.0.0",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium webkit",
    "test:functions": "npm --prefix functions test",
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/firestore.rules.test.js\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "firebase deploy --only firestore,hosting",
    "deploy:functions": "firebase deploy --only functions",
    "cap:add:ios": "npm run build && cap add ios",
    "cap:add:android": "npm run build && cap add android",
    "cap:sync": "npm run build && cap sync"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-firebase/app-check": "^8.5.1",
    "@capacitor-firebase/authentication": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@sentry/browser": "^10.68.0",
    "firebase": "^12.16.0"
  }
}
